# Session handoff notes. Deliberately untracked: it records host paths, local
# tool versions and working state that belong to this machine, not to anyone
# who clones this. Keep it here, keep it out of git.
STATE.md

# Scratch: temporary scripts, captured tool output, working data.
# Project convention keeps these in tmp/ rather than /tmp -- see CLAUDE.md.
tmp/

# Staged copy of a fleet-managed file. Its authoritative home is the
# fleet-files library, not this repository.
fleet-staging/

*.swp

# The hashcat-pattern fork, cloned here for the vanity-vector work. It is a
# separate repository with its own history and remotes; it must never be
# committed into this one.
hashcat-pattern/
